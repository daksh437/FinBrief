PORT=10000
NODE_ENV=development

# Firebase Admin — paste the full service account JSON as a single-line string,
# or unset this and use GOOGLE_APPLICATION_CREDENTIALS pointing at a local file instead.
FIREBASE_SERVICE_ACCOUNT=

# Gemini (AI translation / summary / impact / chat). Omit to run in MOCK mode.
GEMINI_API_KEY=
# Use gemini-flash-latest — pinned versions (e.g. gemini-2.5-flash) get
# retired for new API keys and then 404.
GEMINI_MODEL=gemini-flash-latest

# Google Cloud Text-to-Speech (voice summaries). Omit to run in MOCK mode.
GOOGLE_TTS_API_KEY=

# News aggregation. Omit to run in MOCK mode with sample articles.
NEWS_API_KEY=
NEWS_API_BASE=https://newsapi.org/v2

# Google Play billing verification. Omit to run in MOCK mode (purchases auto-approve).
ANDROID_PACKAGE_NAME=

# AI usage limits
DAILY_CREDITS_FREE=3
DEV_SKIP_LIMITS=false

# Scheduled jobs (news pipeline -> notifications -> FCM). Off by default so
# local runs don't send real pushes; enable on the deployed instance.
ENABLE_CRON_JOBS=false

# Server-side news cache TTL in ms (default 5 minutes).
NEWS_CACHE_TTL_MS=300000

# News needs NO key — RSS (Indian publisher feeds + Google News) is primary.
# NewsAPI above is optional. Market data is likewise keyless:
#   indices/gold/global equities = Yahoo Finance, forex = Frankfurter,
#   crypto = CoinGecko.

# Cron schedules. NOTE: the v12 doc suggests breaking news every 30 seconds
# ('*/30 * * * * *'). That is ~2,880 runs/day and, with AI enrichment,
# thousands of Gemini + news-API calls per day — far beyond free tiers.
# Default below is every 5 minutes; only shorten this on paid plans.
CRON_BREAKING=*/5 * * * *
CRON_REFRESH=*/30 * * * *
CRON_CLEANUP=0 3 * * *
CRON_ANALYTICS=0 * * * *
CRON_MORNING=30 3 * * *
CRON_EVENING=30 12 * * *

# Max articles AI-enriched per pipeline run (cost control).
AI_ENRICH_LIMIT=3
